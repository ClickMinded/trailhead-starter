// Cloudflare settings for putting this site live. The site is plain static files,
// so Cloudflare only needs to know how to build it and where the build puts them.
{
  "name": "trailhead-gear",
  "compatibility_date": "2026-10-01",
  // Build the site before every deploy, so Cloudflare needs no extra settings.
  "build": {
    "command": "npm run build"
  },
  // Every branch and pull request gets its own preview address, so you can see a change before you merge it.
  "previews": {},
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
