---
// Contour lines, drawn once at build time, used as a quiet map texture behind sections.
interface Props { class?: string; tone?: string; rings?: number }
const { class: cls = "", tone = "currentColor", rings = 14 } = Astro.props;
const W = 1200, H = 800;
const centers = [[880, 300], [260, 640]];
const paths: string[] = [];
for (const [cx, cy] of centers) {
  for (let r = 1; r <= rings; r++) {
    const pts: string[] = [];
    for (let a = 0; a <= 360; a += 6) {
      const t = (a * Math.PI) / 180;
      const wob = 1 + 0.12 * Math.sin(3 * t + r * 0.7) + 0.06 * Math.sin(7 * t + r * 1.3);
      const rad = r * 34 * wob;
      pts.push(`${(cx + rad * Math.cos(t)).toFixed(1)},${(cy + rad * 0.72 * Math.sin(t)).toFixed(1)}`);
    }
    paths.push(`M${pts.join("L")}Z`);
  }
}
---
<svg class={`topo ${cls}`} viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid slice" aria-hidden="true">
  {paths.map((d, i) => <path d={d} fill="none" stroke={tone} stroke-width={i % 5 === 4 ? 1.4 : 0.7} />)}
</svg>
<style>
  .topo { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
</style>
