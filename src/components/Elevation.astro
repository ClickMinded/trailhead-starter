---
// A trail elevation profile used as a section divider, with the trailhead marked.
interface Props { label?: string }
const { label = "Trailhead · 0.0 km" } = Astro.props;
const pts = [0, 62, 58, 70, 44, 52, 30, 38, 22, 34, 48, 40, 56, 50, 64, 60, 72].map((y, i, a) => `${(i / (a.length - 1)) * 1000},${y}`);
---
<div class="elev wrap" aria-hidden="true">
  <svg viewBox="0 0 1000 80" preserveAspectRatio="none">
    <polyline points={`0,80 ${pts.join(" ")} 1000,80`} class="fill" />
    <polyline points={pts.join(" ")} class="line" />
  </svg>
  <span class="label">{label}</span>
</div>
<style>
  .elev { position: relative; height: 80px; margin-block: clamp(40px, 6vw, 72px); }
  svg { width: 100%; height: 100%; display: block; }
  .fill { fill: var(--paper-2); }
  .line { fill: none; stroke: var(--ink); stroke-width: 1.4; vector-effect: non-scaling-stroke; stroke-dasharray: 6 5; }
  .label { position: absolute; left: 0; bottom: -26px; }
</style>
