---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
interface Props { product: CollectionEntry<"products">; feature?: boolean }
const { product, feature = false } = Astro.props;
const p = product.data;
---
<a class:list={["card", { feature }]} href={`/shop/${product.id}/`}>
  <div class="media">
    <Image src={p.image} alt={p.imageAlt} widths={[480, 800, 1200]} sizes={feature ? "(max-width: 900px) 100vw, 50vw" : "(max-width: 900px) 100vw, 25vw"} />
    <span class="cat label">{p.category}</span>
  </div>
  <div class="meta">
    <h3>{p.name}</h3>
    <span class="price">${p.price}</span>
  </div>
  <p class="tag">{p.tagline}</p>
</a>
<style>
  .card { display: flex; flex-direction: column; text-decoration: none; }
  .media { position: relative; overflow: hidden; border-radius: var(--radius); background: var(--paper-2); aspect-ratio: 4 / 5; }
  .feature .media { aspect-ratio: 5 / 4; }
  .media :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 0.8s cubic-bezier(0.2, 0.7, 0.2, 1); }
  .card:hover .media :global(img) { transform: scale(1.045); }
  .cat { position: absolute; left: 14px; top: 14px; background: var(--card); color: var(--ink); padding: 6px 10px; border-radius: 999px; font-size: 11px; }
  .meta { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; margin-top: 16px; }
  h3 { font-size: 26px; }
  .feature h3 { font-size: 34px; }
  .price { font-family: var(--font-mono); font-size: 15px; color: var(--ink-2); }
  .tag { margin: 6px 0 0; color: var(--ink-2); font-size: 16px; max-width: 40ch; }
</style>
