---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import Topo from "../../components/Topo.astro";
const posts = (await getCollection("journal")).sort((a, b) => +b.data.publishedAt - +a.data.publishedAt);
const fmt = (d: Date) => d.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" });
---
<Base title="Journal" noindex>
  <section class="head">
    <Topo tone="#dccfb4" rings={10} />
    <div class="wrap">
      <p class="label reveal reveal-1"><span class="blaze"></span>Trail journal</p>
      <h1 class="reveal reveal-2">Read this before<br />your first hike.</h1>
    </div>
  </section>
  <section class="wrap list">
    {posts.map((p, i) => (
      <a class:list={["row", { lead: i === 0 }]} href={`/journal/${p.id}/`}>
        <div class="media"><Image src={p.data.cover} alt={p.data.coverAlt} widths={[600, 1000, 1600]} sizes="(max-width: 900px) 100vw, 50vw" /></div>
        <div class="copy">
          <span class="label">{fmt(p.data.publishedAt)} · {p.data.readingTime}</span>
          <h2>{p.data.title}</h2>
          <p>{p.data.description}</p>
          <span class="link-arrow">Read the guide →</span>
        </div>
      </a>
    ))}
  </section>
</Base>
<style>
  .head { position: relative; overflow: hidden; background: var(--paper-2); padding-block: clamp(64px, 8vw, 110px); }
  .head .wrap { position: relative; }
  h1 { font-size: clamp(48px, 7vw, 96px); margin-top: 16px; }
  .list { display: flex; flex-direction: column; gap: clamp(40px, 6vw, 72px); padding-top: clamp(56px, 7vw, 88px); }
  .row { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(24px, 4vw, 56px); align-items: center; text-decoration: none; }
  .row:nth-child(even) .media { order: 2; }
  .media { overflow: hidden; border-radius: var(--radius); aspect-ratio: 3 / 2; }
  .media :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 0.8s cubic-bezier(0.2, 0.7, 0.2, 1); }
  .row:hover .media :global(img) { transform: scale(1.04); }
  h2 { font-size: clamp(32px, 3.6vw, 48px); margin: 12px 0; }
  .copy p { color: var(--ink-2); margin: 0 0 22px; max-width: 42ch; }
  @media (max-width: 900px) { .row { grid-template-columns: 1fr; } .row:nth-child(even) .media { order: 0; } }
</style>
